# Copy to .env and fill in. .env is gitignored - never commit it.

# Spotify app credentials - https://developer.spotify.com/dashboard
# Create an app, add the redirect URI below to its settings.
# PKCE means no client secret is needed.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# GetSongBPM API key - https://getsongbpm.com/api
# Requires a visible backlink to getsongbpm.com in the app (see About pane).
GETSONGBPM_API_KEY=

# Optional tuning
# Requests per hour ceiling for GetSongBPM (free tier is ~3000/hr).
GETSONGBPM_RATE_PER_HOUR=2400

# Telegram bot (djset telegram) - optional, only needed to control djset from
# Telegram instead of the browser.
# Token from @BotFather - never commit the real value, keep it only in .env.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id - message @userinfobot to find it. Required:
# without it the bot would accept commands from anyone who finds it, and a
# command here can create or delete playlists in your Spotify account.
TELEGRAM_OWNER_ID=
